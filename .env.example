DEEPSEEK_API_KEY=
# Generation runs on DeepSeek V4 Flash with thinking off (pinned in LlmService). Consistency is
# enforced in code (ShellService + screen-normalizer), not by model reasoning, so a thinking or
# pro model buys nothing here and costs a lot more.
# DEEPSEEK_MODEL=deepseek-flash

# Stock photos for image slots (lib/image-slots.ts). Free key: https://www.pexels.com/api/ — 200 requests/hour.
# Without it, image slots render as plain token-coloured blocks.
PEXELS_API_KEY=

# Local testing only: generate through your own Claude Code login (claude -p) instead of DeepSeek,
# so trying things costs no API balance. Never in production, never for evals (prompts are tuned
# for DeepSeek). Optional model, e.g. claude-haiku-4-5-20251001; default is the CLI's own.
# LLM_PROVIDER=claude-cli
# CLAUDE_CLI_MODEL=

# Accounts (Better Auth). BETTER_AUTH_SECRET: a long random string (openssl rand -base64 32).
# BETTER_AUTH_URL: the site's own origin. Google sign-in needs an OAuth client (Web application) with
# the redirect URI <BETTER_AUTH_URL>/api/auth/callback/google. Without Google keys only the email
# link works (printed to the server log in development).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Admin panel (/admin): comma-separated emails that are always admins (more can be named in the panel)
ADMIN_EMAILS=

# Database (INF-10): Postgres. Local default when unset: postgres://localhost:5432/design (createdb design)
DATABASE_URL=postgres://localhost:5432/design

# Payments (BIL-09/10, Polar). sandbox until the live account is approved; then POLAR_SERVER=production
# and a production token. Products: node --env-file=.env --import ./eval/alias-hook.mjs scripts/polar-products.ts
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
POLAR_WEBHOOK_SECRET=
