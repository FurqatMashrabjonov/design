DEEPSEEK_API_KEY=
# Generation is tuned for the fast chat model. Consistency is enforced in code
# (ShellService + screen-normalizer), not by model reasoning, so deepseek-reasoner
# buys nothing here and costs a lot more.
# DEEPSEEK_MODEL=deepseek-chat

# Stock photos for image slots (lib/image-slots.ts). Free key: https://www.pexels.com/api/ — 200 requests/hour.
# Without it, image slots render as plain token-coloured blocks.
PEXELS_API_KEY=
